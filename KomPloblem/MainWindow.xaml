<Window x:Class="KomProblemApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача коммивояжёра — ГА"
        Height="850"
        Width="1250">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="260"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <WrapPanel Margin="8">

                <Label Content="Городов (N):" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtN"
                         Width="55"
                         Text="14"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"/>

                <Label Content="Популяция:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtPop"
                         Width="55"
                         Text="200"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"/>

                <Label Content="Поколений:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtGen"
                         Width="60"
                         Text="3000"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"/>

                <Label Content="Размер турнира:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtTournament"
                         Width="45"
                         Text="3"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"/>

                <Label Content="P кроссовера:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtPC"
                         Width="50"
                         Text="0.9"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"/>

                <Label Content="P мутации:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtPM"
                         Width="50"
                         Text="0.02"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"/>

                <Label Content="Элитных:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtElite"
                         Width="45"
                         Text="2"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"/>

                <Label Content="Seed:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtSeed"
                         Width="55"
                         Text="1"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"/>

                <Button x:Name="BtnGenerate"
                        Content="Сгенерировать"
                        Margin="4"
                        Padding="8,2"
                        Click="OnGenerateClick"/>

                <Button x:Name="BtnStart"
                        Content="Запустить"
                        Margin="4"
                        Padding="8,2"
                        Click="OnStartClick"/>

                <Button x:Name="BtnStop"
                        Content="Стоп"
                        Margin="4"
                        Padding="8,2"
                        Click="OnStopClick"
                        IsEnabled="False"/>

            </WrapPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="12,0,8,8">

                <StackPanel Width="230"
                            VerticalAlignment="Top">
                    <TextBlock Text="Адреса вычислительных сервисов:"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>

                    <TextBlock Text="Один адрес на строку"
                               Foreground="Gray"
                               FontSize="11"/>
                </StackPanel>

                <TextBox x:Name="TxtServiceUrls"
                         Width="420"
                         Height="65"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Text="https://localhost:7208/&#10;http://localhost:5046/"/>

            </StackPanel>

        </StackPanel>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Canvas Grid.Column="0"
                    x:Name="TourCanvas"
                    Background="White"
                    SizeChanged="OnTourCanvasSizeChanged"/>

            <GroupBox Grid.Column="1"
                      Header="Лучший найденный маршрут"
                      Margin="8,0,0,0">

                <TextBox x:Name="TxtRoute"
                         Margin="6"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="13"/>
            </GroupBox>
        </Grid>

        <Canvas Grid.Row="2"
                x:Name="ChartCanvas"
                Background="#FAFAFA"
                Margin="8"
                SizeChanged="OnChartCanvasSizeChanged"/>

        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus"
                           Text="Готово"/>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
